{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoKo",
  "version": "0.1.0",
  "identifier": "com.coko.tracker",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CoKo",
        "url": "index.html",
        "width": 1040,
        "height": 700,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "center": true
      },
      {
        "label": "widget",
        "title": "CoKo",
        "url": "widget.html",
        "width": 210,
        "height": 230,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Desktop assistant & daily activity tracker"
  }
}